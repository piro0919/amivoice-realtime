{
  "name": "amivoice-realtime",
  "version": "0.1.3",
  "description": "Unofficial realtime (WebSocket) speech recognition client for the AmiVoice Cloud Platform API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "amivoice",
    "speech-recognition",
    "asr",
    "realtime",
    "websocket",
    "japanese",
    "transcription"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/amivoice-realtime.git"
  },
  "funding": "https://github.com/sponsors/piro0919",
  "bugs": {
    "url": "https://github.com/piro0919/amivoice-realtime/issues"
  },
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:lib": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build:lib"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vercel/analytics": "^2.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "lefthook": "^2.1.10",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "homepage": "https://amivoice-realtime.kkweb.io/"
}
